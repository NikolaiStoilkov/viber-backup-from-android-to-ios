<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: the helper never talks to the network. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_save"
        android:label="Viber Transfer Helper"
        android:theme="@android:style/Theme.Material.Light">

        <!-- Exported so `adb shell am start` from the Mac can open it. Copying still
             requires the user to tap "Start copy" here and grant root in Magisk. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CopyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
